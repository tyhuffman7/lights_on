# Template: set User, WorkingDirectory and ExecStart to your worker host.
[Unit]
Description=Lights On paper research observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lights-on
WorkingDirectory=/opt/lights-on
ExecStart=/usr/bin/node --experimental-strip-types worker/cli.ts observe
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
